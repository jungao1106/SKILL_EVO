LLM_PROVIDER=openai

# Generic OpenAI-compatible provider. Use this for GLM 5.1, GPT 5.5, Claude,
# or any router that exposes an OpenAI-compatible base URL plus model name.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.novita.ai/v3/openai
OPENAI_COMPAT_MODEL=zai-org/glm-5.2
OPENAI_COMPAT_API=openai-completions
OPENAI_COMPAT_CONTEXT_WINDOW=128000
OPENAI_COMPAT_MAX_TOKENS=32000
OPENAI_COMPAT_THINKING_AS_TEXT=true
OPENAI_COMPAT_THINKING_FORMAT=zai
OPENAI_COMPAT_REASONING_EFFORT=none
OPENAI_COMPAT_ENABLE_THINKING=false

# For Macaron GLM 5.2 Responses through the generic compatibility profile:
# CLAUDE_CODE_ATTRIBUTION_HEADER=0
# OPENAI_COMPAT_BASE_URL=https://pi-api-cn.macaron.xin/v1
# OPENAI_COMPAT_MODEL=glm-5.2
# OPENAI_COMPAT_API=openai-responses
# OPENAI_COMPAT_CONTEXT_WINDOW=200000
# OPENAI_COMPAT_THINKING_AS_TEXT=true
# OPENAI_COMPAT_THINKING_FORMAT=zai
# OPENAI_COMPAT_REASONING_EFFORT=none
# OPENAI_COMPAT_ENABLE_THINKING=false
#
# For Claude through an OpenAI-compatible router:
# OPENAI_COMPAT_BASE_URL=https://your-router.example/v1
# OPENAI_COMPAT_MODEL=claude-sonnet-4-5
# OPENAI_COMPAT_API=openai-completions
# OPENAI_COMPAT_THINKING_AS_TEXT=false

# First-class GLM provider profiles. Pi uses *_BASE_URL (OpenAI-compatible);
# Claude Code uses *_ANTHROPIC_BASE_URL (Anthropic-style).
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_ANTHROPIC_BASE_URL=https://api.novita.ai/anthropic
NOVITA_MODEL=zai-org/glm-5.2
NOVITA_API=openai-completions
NOVITA_CONTEXT_WINDOW=128000
NOVITA_MAX_TOKENS=32000
NOVITA_THINKING_AS_TEXT=true
NOVITA_THINKING_FORMAT=zai
NOVITA_REASONING_EFFORT=none
NOVITA_ENABLE_THINKING=false

MACARON_API_KEY=
MACARON_BASE_URL=https://pi-api-cn.macaron.xin/v1
MACARON_ANTHROPIC_BASE_URL=https://pi-api.macaron.xin/anthropic
MACARON_MODEL=glm-5.2
MACARON_API=openai-responses
MACARON_CONTEXT_WINDOW=200000
MACARON_MAX_TOKENS=32000
MACARON_THINKING_AS_TEXT=true
MACARON_THINKING_FORMAT=zai
MACARON_REASONING_EFFORT=none
MACARON_ENABLE_THINKING=false
CLAUDE_CODE_ATTRIBUTION_HEADER=0

SGLANG_API_KEY=
SGLANG_BASE_URL=http://34.201.124.250:39606/v1
SGLANG_ANTHROPIC_BASE_URL=http://34.201.124.250:39606
SGLANG_MODEL=zai-org/GLM-5.2-FP8
SGLANG_API=openai-completions
SGLANG_CONTEXT_WINDOW=128000
SGLANG_MAX_TOKENS=32000
SGLANG_THINKING_AS_TEXT=true
SGLANG_THINKING_FORMAT=zai
SGLANG_REASONING_EFFORT=none
SGLANG_ENABLE_THINKING=false

# Tinker path kept as a separate provider profile.
TINKER_API_KEY=
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16:peft:262144
TINKER_API=openai-completions
TINKER_CONTEXT_WINDOW=262144
TINKER_MAX_TOKENS=32000
TINKER_THINKING_FORMAT=zai

E2B_API_KEY=
E2B_CONCURRENCY=15
E2B_TEMPLATE_NAMESPACE=anchen1011
E2B_PI_TEMPLATE_SUFFIX=pi_c6d7003a
E2B_SANDBOX_TIMEOUT_SEC=3600
E2B_OVERRIDE_CPUS=1
E2B_OVERRIDE_MEMORY_MB=4096
E2B_OVERRIDE_STORAGE_MB=10240

TIMEOUT_MULTIPLIER=1.0
AGENT_TIMEOUT_MULTIPLIER=
VERIFIER_TIMEOUT_MULTIPLIER=
AGENT_SETUP_TIMEOUT_MULTIPLIER=2.0
ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER=2.0
AGENT_SETUP_TIMEOUT_SEC=1200
AGENT_TIMEOUT_SEC=

HARBOR_DATASET=swe-bench/swe-bench-verified@2
JOB_NAME=pi_openai_glm51_skills
HARBOR_AGENT=pi
BENCHMARK_AGENT=pi
DEEPSWE_TASKS=/vePFS-Mindverse/user/intern/jungao/Marcronv1-Coding/deep-swe/tasks
ENABLE_DEEPSWE_PRE_ARTIFACTS=true
DISABLE_DEEPSWE_PRE_ARTIFACTS=false
DISABLE_VERIFIER=false
FORCE_AGENT_INTERNET=false
CLAUDE_MAX_TURNS=
CLAUDE_MAX_BUDGET_USD=

# Terminal-Bench 2.0 defaults. E2B is the default Harbor environment; use
# TERMINAL_BENCH_ENVIRONMENT=docker only for local Docker debugging.
TERMINAL_BENCH_DATASET=terminal-bench/terminal-bench-2
TERMINAL_BENCH_DATASET_REF=latest
TERMINAL_BENCH_JOB_NAME=tb2_pi_openai_noskills
TERMINAL_BENCH_ENVIRONMENT=e2b
TERMINAL_BENCH_CONCURRENCY=1
TERMINAL_BENCH_N_ATTEMPTS=1
TERMINAL_BENCH_N_TASKS=
TERMINAL_BENCH_USE_SKILLS=false
TERMINAL_BENCH_RESULT_ONLY=false
TERMINAL_BENCH_REQUIRE_WORKSPACE_CHANGE=false
TERMINAL_BENCH_OVERRIDE_CPUS=2
TERMINAL_BENCH_OVERRIDE_MEMORY_MB=8192
TERMINAL_BENCH_OVERRIDE_STORAGE_MB=20480
TERMINAL_BENCH_OVERRIDE_GPUS=

PI_USE_SKILLS=true
PI_THINKING=off
PI_TOOLS=read,write,edit,bash,grep,find,ls
RESULT_ONLY=false
